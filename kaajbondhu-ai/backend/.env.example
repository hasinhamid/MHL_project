# demo runs locally without credentials; live requires all three AI values below.
AI_MODE=demo
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# json_object, json_schema, or none depending on your inference provider.
AI_RESPONSE_FORMAT=json_object
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Optional absolute path for demo worker persistence.
# WORKERS_FILE=/path/to/registered_workers.json
